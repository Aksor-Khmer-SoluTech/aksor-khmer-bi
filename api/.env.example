# Local dev env vars for `uvicorn app.main:app --env-file .env`.
# Copy this file to `.env` (gitignored, never commit real credentials). In local development the
# API loads it itself at startup (app/dev_env.py) -- filling only variables that aren't already set,
# and never inside a container or under pytest. Docker Compose reads its own settings as before.
# and adjust as needed -- see ../docs/deployment.md for the full reference.

# Break-glass superuser -- unset means every admin route stays 503'd
# closed until at least one database user exists. See app/auth.py.
PORTAL_USERNAME=admin
PORTAL_PASSWORD=admin12345

# Origins allowed to call this api cross-origin -- needs to include
# wherever the portal is actually running. `npm run dev` -> :5173,
# `npm run preview` -> :4173, the Dockerized portal -> :8080.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# Left unset here on purpose -- defaults to a local SQLite file
# (api/aksor_khmer_bi.db, gitignored). Point this at Postgres instead
# once you need it: postgresql+psycopg://user:pass@localhost:5432/db
# DATABASE_URL=

# Root logging level -- DEBUG, INFO, WARNING (or WARN), ERROR. Unset
# defaults to INFO. Set DEBUG to see per-request/job chatter; anything an
# `except` block logs via `_log.exception(...)` (full traceback) always
# prints at ERROR and above regardless of this setting. See app/logging_config.py.
# LOG_LEVEL=DEBUG

# Where rotating log files are written (relative to the process's cwd --
# api/ locally, /app/api in the container) and the max size of each one
# before it rolls to the next sequence number for the same date (e.g.
# api-2026-09-15.log -> api-2026-09-15.1.log). Both default sensibly;
# override only if you need a different location/size.
# LOG_DIR=logs
# LOG_MAX_BYTES=26214400

# A report's own data_source can reference an env var by name via its
# auth.token_env (see app/report_data.py) -- never a secret value in the
# report's own config, which every report:manage admin can read. Set
# whichever ones your registered reports' data sources actually need; none
# are required unless a report's data-config names them.
#
# (A *Secret* -- Admin -> Secrets -- can keep this token in the portal instead, encrypted, created
# and rotated there directly; a report's own data source or a connection can name it instead of this
# environment variable. See SECRETS_ENCRYPTION_KEY below.)

# The time zone a parameter's `now()` default is read in when a run leaves that
# parameter out (an API call, an embed) -- an IANA name. Unset = UTC. The portal's
# run form fills `now()` from the viewer's own clock, so this only matters for those.
# REPORT_TIMEZONE=Asia/Phnom_Penh

# Verifies the signed tickets an embedding app sends with a report's parameters
# (POST /api/v1/reports/{id}/embed-run) -- 32+ characters, the same value the
# embedding app signs with (partner-api: AKSOR_EMBED_SECRET). Unset, that route
# answers 503 instead of trusting anything. See docs/building-a-report.md.
# EMBED_TICKET_SECRET=

# An embedding app runs a report by parameters with an API client (Admin -> API Clients in the
# portal: a client id + secret granted specific reports, changed at runtime with no restart) or a
# signed ticket (EMBED_TICKET_SECRET above). CLIENT_RUN_LIMIT_PER_MINUTE caps embed-run calls per
# client (default 120).
# See docs/building-a-report.md ("Running a report as an API client").
# CLIENT_RUN_LIMIT_PER_MINUTE=120

# Encrypts every Secret (Admin -> Secrets). Optional: unset, the API generates a key into
# data/secrets/master.key on first use (gitignored). Set it (a Fernet key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") to manage the
# key yourself. Whichever you use, back it up with the database -- lose it and stored credentials have to
# be entered again.
# SECRETS_ENCRYPTION_KEY=

# ---- Sign-in (see docs/authentication.md) ----------------------------------------------------
# People sign in at POST /api/v1/auth/login and get a 15-minute access token (a JWT) plus a refresh token in an
# HttpOnly cookie. The portal and this API must be the same *site* (localhost and localhost:8000 are; localhost
# and 127.0.0.1 are not), and CORS_ALLOWED_ORIGINS above must name the portal's exact origin.
#
# Signing key for access tokens (32+ characters). Optional: unset, a key is generated into
# data/secrets/jwt.key on first use. Set it when you run more than one API process, so they share it.
# JWT_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_SESSION_HOURS=12     # a sign-in's length ...
# REFRESH_TOKEN_TTL_DAYS=30          # ... or with "Keep me signed in"
# REFRESH_GRACE_SECONDS=10
# `curl -u user:password` for scripts. false = everything must use /auth/login. 2FA accounts can't use it.
# LOGIN_ATTEMPTS_PER_MINUTE=10      # sign-in attempts per address and user name before 429
# AUTH_ALLOW_BASIC=true
# The refresh cookie: Secure follows the request (auto) -- false for a plain-http test behind a proxy;
# SameSite lax | strict | none (none needs HTTPS and is for a portal on another site).
# AUTH_COOKIE_SECURE=auto
# AUTH_COOKIE_SAMESITE=lax
