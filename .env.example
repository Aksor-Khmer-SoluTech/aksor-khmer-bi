# Settings for the Docker deployment. Copy to `.env` (gitignored -- never commit real values)
# or let `./deployment.sh init` do it and fill in the passwords for you.
#
# How to read this file
#   * Every setting has a short explanation and its default. A line that is NOT commented out
#     is already set to the default (or to the value you must change) -- edit it in place.
#   * A line starting with `# NAME=` is unset by default: it has no sensible predefined value
#     (a secret, a server address, ...) or the feature is off until you provide one. Remove the
#     `#` and fill it in to use it.
#   * All compose files read this one file; docker-compose.yml's services (api, scheduler,
#     worker, portal) also receive every variable here as an environment variable.
# Full reference: docs/deployment.md. (To run the API outside Docker, see api/.env.example.)

# =====================================================================================
#  1. Version and ports -- decide these first
# =====================================================================================

# Images are named ${AKSOR_IMAGE_PREFIX}-engine / -portal / -jdbc-worker, tag AKSOR_VERSION.
# `up` and `update` PULL these prebuilt images (no build, no Node/npm on the server). Set AKSOR_VERSION to
# the released version you want -- read CHANGELOG.md for every version up to it first. Releases are
# published by pushing a git tag `v<version>` (.github/workflows/release-images.yml). The value below is the
# release this checkout was made for; update it when you upgrade.
# To build from the source instead (advanced): `./deployment.sh up --build` / `update --build`, which adds
# docker-compose.build.yml.
AKSOR_IMAGE_PREFIX=ghcr.io/aksor-khmer-solutech/aksor-khmer-bi
AKSOR_VERSION=1.0.0

# Host port the API is published on (docs at http://localhost:<API_PORT>/docs). The container
# itself always listens on 8000. If you change it, also set PORTAL_API_BASE_URL in the portal
# config file (PORTAL_CONFIG_FILE below) to the API's new address.
# Default: 8000
API_PORT=8000

# Host port the portal (the web console) is published on. If you change it, update
# CORS_ALLOWED_ORIGINS (section 2 below) to match.
# Default: 8080
PORTAL_PORT=8080

# =====================================================================================
#  2. Required -- change these before you start
# =====================================================================================

# Password of the `aksor` database user. Shared by postgres and the app's DATABASE_URL, so
# change it here only. Applied when the database is first created -- changing it later does
# NOT change an existing database's password (ALTER USER it, then update this).
# Default: empty (`./deployment.sh init` generates a random one).
POSTGRES_PASSWORD=

# Break-glass superuser for the admin surface. Sign in once, create real accounts under
# Admin > Users, then remove these two lines. Unset = every admin route answers 503.
# Default user name: admin. Default password: empty (`./deployment.sh init` generates one) -- there is no
# usable default: `./deployment.sh up` warns on an empty one and refuses a guessable one (`admin`, `password`, `changeme`, under 8 characters...).
PORTAL_USERNAME=admin
PORTAL_PASSWORD=

# Password for Redis (the job queue). Empty = Redis accepts any container on the aksor-network, as before; set it
# (`./deployment.sh init` generates one for a new .env) so only the app can use the queue. Letters and digits only.
# Changing it needs the redis stack recreated: ./deployment.sh up. Ignored when REDIS_URL is set.
REDIS_PASSWORD=

# Origin(s) the portal is opened from, comma-separated -- exactly what users type in the
# browser (scheme + host + port, no path), e.g. https://reports.example.com. Wrong value =
# the portal's sign-in silently fails.
# Default: http://localhost:8080 (the portal on this machine at its default port).
CORS_ALLOWED_ORIGINS=http://localhost:8080

# =====================================================================================
#  3. Portal address and config
# =====================================================================================

# Portal runtime config file mounted into the portal container: the API's URL and branding
# (PORTAL_API_BASE_URL, PORTAL_BRAND_NAME, ...). Edit it to point the portal at a public API.
# Default: ./portal/public/config.js
PORTAL_CONFIG_FILE=./portal/public/config.js

# =====================================================================================
#  4. Sign-in (see docs/authentication.md)
#     People sign in with a short-lived access token (JWT) plus a refresh token kept in an
#     HttpOnly cookie. The portal and the API must be the same *site* (same registrable
#     domain; ports and subdomains don't matter) and CORS_ALLOWED_ORIGINS must be the
#     portal's exact origin.
# =====================================================================================

# Key that signs access tokens (32+ characters). Set it when you run several api replicas so
# they all accept each other's tokens.
# Default: unset -- a key is generated into data/secrets/jwt.key on first start.
# JWT_SECRET=

# How long an access token lives before the portal silently renews it. 60-3600.
# Default: 900 (15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900

# How long someone stays signed in without "Keep me signed in" (refresh token lifetime, in
# hours; 1-72) ...
# Default: 12
REFRESH_TOKEN_SESSION_HOURS=12

# ... and with it ticked (in days; 1-180).
# Default: 30
REFRESH_TOKEN_TTL_DAYS=30

# Sign-in attempts allowed per minute for one address / user name before the API answers 429.
# 1-1000.
# Default: 10
LOGIN_ATTEMPTS_PER_MINUTE=10

# Whether scripts may still use HTTP Basic credentials. false = they must sign in at
# /api/v1/auth/login like everyone else. Accounts with two-factor on are always refused Basic.
# Default: true
AUTH_ALLOW_BASIC=true

# Whether the refresh cookie is marked Secure (sent only over HTTPS). auto = Secure when the
# request came in over HTTPS. Use false on plain http only for testing.
# Default: auto   (auto | true | false)
AUTH_COOKIE_SECURE=auto

# SameSite attribute of the refresh cookie. `none` is needed only when the portal runs on a
# different site than the API, and then requires HTTPS.
# Default: lax   (lax | strict | none)
AUTH_COOKIE_SAMESITE=lax

# Name shown next to the account in authenticator apps for two-factor sign-in.
# Default: Aksor Khmer BI
TOTP_ISSUER=Aksor Khmer BI

# =====================================================================================
#  5. Reports and limits
# =====================================================================================

# Time zone (IANA name, e.g. Asia/Phnom_Penh) used when a report parameter's default is
# `now()` and a run leaves it out (API / embed calls). The portal's run form uses the
# viewer's own clock instead.
# Default: UTC
REPORT_TIMEZONE=UTC

# Table rows per output file before a report is split into several files. Max 5000.
# Default: 1000
MAX_ROWS_PER_FILE=1000

# Most files one request may produce. Max 100.
# Default: 20
MAX_REPORT_PARTS=20

# Records per batch request for pdf / png output (slow conversions). Max 200.
# Default: 30
MAX_BATCH_PDF_PNG=30

# Records per batch request for docx / xlsx output. Max 5000.
# Default: 1000
MAX_BATCH_DOCX_XLSX=1000

# How often (seconds) the scheduler looks for new, edited or paused jobs.
# Default: 15
SCHEDULER_RECONCILE_INTERVAL_SECONDS=15

# Runs per minute one API client (Admin > API Clients) may make.
# Default: 120
CLIENT_RUN_LIMIT_PER_MINUTE=120

# =====================================================================================
#  6. Secrets and integrations
# =====================================================================================

# Fernet key that encrypts stored Secrets (Admin > Secrets) and two-factor secrets. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up WITH the database -- lose it and stored credentials must be entered again.
# Default: unset -- a key is generated into data/secrets/master.key on first use.
# SECRETS_ENCRYPTION_KEY=

# Secret (32+ characters) shared with an app that embeds reports: the same value it signs its
# tickets with. Unset, the embed-ticket route answers 503. (API clients need no variable.)
# Default: unset
# EMBED_TICKET_SECRET=

# =====================================================================================
#  7. Logging
# =====================================================================================

# How much the API logs. DEBUG shows per-request detail; errors are always logged.
# Default: INFO   (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Size in bytes at which a log file rolls over to the next one (files live in data/logs).
# Default: 26214400 (25 MB)
LOG_MAX_BYTES=26214400

# =====================================================================================
#  8. Building from source (advanced -- not needed for the prebuilt images)
# =====================================================================================

# Network the image BUILD uses to download packages. `default` is Docker's normal bridge. If builds
# time out reaching deb.debian.org / pypi.org / npm on a server that otherwise has internet (typical
# when a firewall or Docker's bridge forwarding is misconfigured -- see docs/deployment.md, "Get Docker ready"), try `host`
# to use the server's own network for the build.
# Default: default   (default | host)
BUILD_NETWORK=default

# Building on a server that can't reach the internet? Point the build at internal mirrors
# (host name only for apt; full URLs for pip and npm), or use the
# prebuilt images (the default for `up`). Defaults are the public sources.
# Default: deb.debian.org
APT_MIRROR=deb.debian.org
# apt over `http` (Debian's default) or `https`. Use https if the network blocks port 80 but allows 443
# (the doctor then fails only on deb.debian.org while pypi/npm pass).
# Default: http   (http | https)
APT_SCHEME=http
# Default: https://pypi.org/simple
PIP_INDEX_URL=https://pypi.org/simple
# Default: https://registry.npmjs.org/
NPM_REGISTRY=https://registry.npmjs.org/

# =====================================================================================
#  9. Managed Postgres / Redis (instead of docker-compose.db.yml / docker-compose.redis.yml)
#     Skip those stacks and point the app at your own.
# =====================================================================================

# Default: unset -- built from POSTGRES_PASSWORD for the bundled postgres:
#   postgresql+psycopg://aksor:<POSTGRES_PASSWORD>@postgres:5432/aksor_khmer_bi
# DATABASE_URL=postgresql+psycopg://user:pass@db.example.com:5432/aksor_khmer_bi

# Default: unset -- the bundled redis, redis://redis:6379/0
# REDIS_URL=redis://redis.example.com:6379/0

# =====================================================================================
#  10. Database drivers for reports (Admin > Connections, Admin > JDBC Drivers)
#     PostgreSQL, MySQL and MariaDB use built-in drivers. Oracle, SQL Server, Db2... run on a
#     vendor .jar uploaded in the portal, executed by the isolated `jdbc-worker` service
#     (`docker compose --profile jdbc up -d`).
# =====================================================================================

# Shared token between the api and the jdbc-worker. Needed only for uploaded drivers; the worker
# refuses to start without it, or with one shorter than 32 characters.
# There is deliberately NO example value: a token copied from a file is known to everyone who
# has read that file. Generate your own (64 hex characters = 256 bits) and paste it here:
#   openssl rand -hex 32
# Default: unset (no worker)
# JDBC_WORKER_TOKEN=

# Limit where database connections may point: host names, *.suffix patterns or CIDR ranges,
# comma-separated. Link-local and cloud-metadata addresses are always refused.
# Default: unset -- any other address is allowed
# JDBC_ALLOWED_HOSTS=*.corp.example.com,10.20.0.0/16

# CA file the verify-ca / verify-full SSL modes check database certificates against, when they
# aren't signed by a public CA.
# Default: unset -- the system certificate store
# JDBC_CA_BUNDLE=/app/data/secrets/db-ca.pem

# Most rows one report query may return; more is an error, not a silent cut-off.
# Default: 20000
JDBC_MAX_ROWS=20000

# Seconds a report query may run before it is stopped.
# Default: 30
JDBC_TIMEOUT_SECONDS=30

# Largest driver upload, in megabytes.
# Default: 80
JDBC_DRIVER_MAX_MB=80
